{
  "expo": {
    "name": "Sprout",
    "slug": "sprout",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sprout",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.m0rteum.sprout",
      "supportsTablet": true
    },
    "android": {
      "package": "com.m0rteum.sprout",
      "adaptiveIcon": {
        "backgroundColor": "#2F6B45",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1E8",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": { "backgroundColor": "#121712" }
        }
      ],
      [
        "expo-notifications",
        { "color": "#2F6B45" }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sprout uses your photos so you can add pictures of your plants.",
          "cameraPermission": "Sprout uses the camera to photograph and identify your plants."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
